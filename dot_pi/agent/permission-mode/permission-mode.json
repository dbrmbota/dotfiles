{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/main/schemas/permission-mode.schema.json",
  "defaultMode": "default",
  "cycleOrder": [
    "default",
    "read-only"
  ],
  "modes": {
    "default": {
      "label": "Allow write",
      "color": "accent",
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [
          ".",
          "/tmp",
          "/private/tmp",
          "~/.npm",
          "~/.cache",
          "~/Library/Caches",
          "~/.pnpm-store",
          "~/.bun/install/cache",
          "~/.yarn/cache",
          "~/.cargo/registry",
          "~/.cargo/git",
          "~/go/pkg",
          "~/.local/share/uv",
          "~/.local/share/pnpm"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.config/gh",
          "~/.docker/config.json",
          "~/.netrc",
          "~/.pi/agent/auth.json",
          "~/.config/pi/web-search.json",
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/*.p12",
          "**/*.pfx"
        ],
        "network": {
          "allowedDomains": [
            "github.com",
            "*.github.com",
            "raw.githubusercontent.com",
            "registry.npmjs.org",
            "*.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "files.pythonhosted.org",
            "proxy.golang.org",
            "crates.io",
            "*.crates.io"
          ],
          "deniedDomains": []
        },
        "askOnBlockedHost": true
      },
      "permission": {
        "path": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*/.ssh/*": "deny",
          "*/.aws/*": "deny",
          "*/.gnupg/*": "deny",
          "*/.netrc": "deny",
          "~/.pi/agent/auth.json": "deny",
          "~/.config/pi/web-search.json": "deny"
        },
        "external_directory": "ask",
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "sudo*": "deny",
          "su *": "deny",
          "doas*": "deny",
          "rm -r*": "ask",
          "rm -R*": "ask",
          "rm -f*": "ask",
          "rm * -r*": "ask",
          "rm * -R*": "ask",
          "rm * -f*": "ask",
          "rm *--recursive*": "ask",
          "rm *--force*": "ask",
          "find * -delete*": "ask",
          "find * -exec rm*": "ask",
          "git push*--force*": "ask",
          "git push -f*": "ask",
          "git push * -f*": "ask",
          "git reset --hard*": "ask",
          "git clean*": "ask",
          "git checkout -- *": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "chmod -R*": "ask",
          "chown -R*": "ask",
          "dd *": "ask",
          "mkfs*": "ask",
          "diskutil*": "ask",
          "kill -9*": "ask",
          "killall*": "ask",
          "pkill*": "ask",
          "brew uninstall*": "ask",
          "npm uninstall -g*": "ask",
          "chezmoi apply*": "ask"
        },
        "web_search": "allow",
        "tool": "allow",
        "skill": "allow"
      }
    },
    "read-only": {
      "label": "Read only",
      "color": "mdLink",
      "systemPrompt": "The project directory is read-only at the OS level. For any clones, downloads, or scratch files, use $TMPDIR (or /tmp).",
      "sandbox": {
        "enabled": true,
        "writable": true,
        "allowWrite": [
          "/tmp",
          "/private/tmp",
          "~/.npm",
          "~/.cache",
          "~/Library/Caches",
          "~/.pnpm-store",
          "~/.bun/install/cache",
          "~/.yarn/cache",
          "~/.cargo/registry",
          "~/.cargo/git",
          "~/go/pkg",
          "~/.local/share/uv",
          "~/.local/share/pnpm"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.config/gh",
          "~/.docker/config.json",
          "~/.netrc",
          "~/.pi/agent/auth.json",
          "~/.config/pi/web-search.json",
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/*.p12",
          "**/*.pfx"
        ],
        "network": {
          "allowedDomains": [
            "github.com",
            "*.github.com",
            "raw.githubusercontent.com",
            "registry.npmjs.org",
            "*.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "files.pythonhosted.org",
            "proxy.golang.org",
            "crates.io",
            "*.crates.io"
          ],
          "deniedDomains": []
        },
        "askOnBlockedHost": true
      },
      "permission": {
        "path": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*/.ssh/*": "deny",
          "*/.aws/*": "deny",
          "*/.gnupg/*": "deny",
          "*/.netrc": "deny",
          "~/.pi/agent/auth.json": "deny",
          "~/.config/pi/web-search.json": "deny"
        },
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
          "/tmp/*": "allow",
          "/private/tmp": "allow",
          "/private/tmp/*": "allow",
          "/var/folders/*": "allow",
          "/private/var/folders/*": "allow"
        },
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "write": {
          "*": "deny",
          "/tmp": "allow",
          "/tmp/*": "allow",
          "/private/tmp": "allow",
          "/private/tmp/*": "allow",
          "/var/folders/*": "allow",
          "/private/var/folders/*": "allow"
        },
        "edit": {
          "*": "deny",
          "/tmp": "allow",
          "/tmp/*": "allow",
          "/private/tmp": "allow",
          "/private/tmp/*": "allow",
          "/var/folders/*": "allow",
          "/private/var/folders/*": "allow"
        },
        "bash": {
          "*": "allow",
          "sudo*": "deny",
          "su *": "deny",
          "doas*": "deny",
          "rm -r*": "ask",
          "rm -R*": "ask",
          "rm -f*": "ask",
          "rm * -r*": "ask",
          "rm * -R*": "ask",
          "rm * -f*": "ask",
          "rm *--recursive*": "ask",
          "rm *--force*": "ask",
          "find * -delete*": "ask",
          "find * -exec rm*": "ask",
          "git push*--force*": "ask",
          "git push -f*": "ask",
          "git push * -f*": "ask",
          "git reset --hard*": "ask",
          "git clean*": "ask",
          "git checkout -- *": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "chmod -R*": "ask",
          "chown -R*": "ask",
          "dd *": "ask",
          "mkfs*": "ask",
          "diskutil*": "ask",
          "kill -9*": "ask",
          "killall*": "ask",
          "pkill*": "ask",
          "brew uninstall*": "ask",
          "npm uninstall -g*": "ask",
          "chezmoi apply*": "ask"
        },
        "web_search": "allow",
        "tool": "allow",
        "skill": "allow"
      }
    }
  }
}
