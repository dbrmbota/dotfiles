{
  "enabled": true,
  "sandboxUserShell": false,
  "permissionPromptTimeoutSeconds": 0,
  "network": {
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org",
      "proxy.golang.org",
      "crates.io",
      "*.crates.io",
      "release-assets.githubusercontent.com",
      "go.temporal.io",
      "registry-1.docker.io",
      "opencode.ai",
      "numerique-gouv.github.io",
      "quay.io",
      "hub.docker.com",
      "formulae.brew.sh",
      "pricing.us-east-1.amazonaws.com",
      "www.scaleway.com",
      "b0.p.awsstatic.com",
      "calculator.aws",
      "openrouter.ai",
      "developer.apple.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "/var/folders",
      "/private/var/folders",
      "~/.npm",
      "~/.cache",
      "~/Library/Caches",
      "~/.pnpm-store",
      "~/.bun/install/cache",
      "~/.yarn/cache",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/go/pkg",
      "~/.local/share/uv",
      "~/.local/share/pnpm/store",
      "~/Library/pnpm/store",
      "~/.pi/agent/artifacts"
    ],
    "allowRead": [
      ".",
      "~/.pi/agent/agents",
      "~/.pi/agent/extensions",
      "~/.pi/agent/prompts",
      "~/.pi/agent/skills",
      "~/.pi/agent/themes",
      "~/.pi/agent/npm/node_modules",
      "~/.pi/agent/git",
      "~/.pi/agent/settings.json",
      "~/.pi/agent/keybindings.json",
      "~/.pi/agent/sandbox.json",
      "/opt/homebrew/Cellar/pi-coding-agent",
      "/home/linuxbrew/.linuxbrew/Cellar/pi-coding-agent",
      "/Users/dbrmbota/.config/herdr-app/AGENTS.md"
    ],
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.config/scw",
      "~/.config/hcloud",
      "~/.gnupg",
      "~/.docker/config.json",
      "~/.netrc",
      "~/.git-credentials",
      "~/.pypirc",
      "~/.gem/credentials",
      "~/.vault-token",
      "~/.password-store",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/oauth.json",
      "~/.config/opencode/opencode.json",
      "~/.config/opencode/opencode.jsonc",
      "~/.config/pi/web-search.json",
      "~/.config/gh",
      "~/.config/atlas",
      "~/Library/Keychains",
      "~/.zshrc",
      "~/.zshenv",
      "~/.zprofile",
      "~/.zlogin",
      "~/.zlogout",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.bash_login",
      "~/.bash_logout",
      "~/.profile",
      "~/.zsh_history",
      "~/.bash_history"
    ],
    "denyWrite": [
      "/opt/homebrew/Cellar/pi-coding-agent",
      "/home/linuxbrew/.linuxbrew/Cellar/pi-coding-agent",
      "~/.pi/agent/npm/node_modules",
      "~/.pi/agent/sandbox.json",
      ".pi/sandbox.json",
      ".pi/settings.json",
      ".pi/extensions",
      ".git/hooks"
    ]
  }
}
