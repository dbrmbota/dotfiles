{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "authorizerChain": [
    "floor-deny"
  ],
  "commandEffects": {
    "git": {
      "unlessOption": [
        "--output"
      ],
      "subcommands": {
        "log": "read",
        "diff": "read"
      }
    },
    "chezmoi": {
      "subcommands": {
        "diff": "read",
        "status": "read"
      }
    },
    "jq": {
      "effects": "read"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.azure": "deny",
      "~/.azure/*": "deny",
      "~/.config/gh": "deny",
      "~/.config/gh/*": "deny",
      "~/.config/scw": "deny",
      "~/.config/scw/*": "deny",
      "~/.config/hcloud": "deny",
      "~/.config/hcloud/*": "deny",
      "~/.config/atlas": "deny",
      "~/.config/atlas/*": "deny",
      "~/.password-store": "deny",
      "~/.password-store/*": "deny",
      "~/Library/Keychains": "deny",
      "~/Library/Keychains/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/.pypirc": "deny",
      "~/.gem/credentials": "deny",
      "~/.s3cfg": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.vault-token": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/oauth.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.claude.json": "deny",
      "~/.config/opencode/opencode.json": "deny",
      "~/.config/opencode/opencode.jsonc": "deny",
      "~/.config/pi/web-search.json": "deny",
      "~/.zshrc.secrets": "deny",
      "~/.zsh_history": "deny",
      "~/.zsh_sessions": "deny",
      "~/.zsh_sessions/*": "deny",
      "~/.bash_history": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "path_write": {
      "~/.zshrc": "deny",
      "~/.pi/agent/settings.json": "deny",
      "~/.pi/agent/trust.json": "deny",
      "~/.pi/agent/extensions": "deny",
      "~/.pi/agent/extensions/*": "deny",
      "~/.pi/agent/npm/node_modules/*": "deny",
      ".pi/settings.json": "deny",
      "*/.pi/settings.json": "deny",
      ".pi/extensions/*": "deny",
      "*/.pi/extensions/*": "deny",
      ".git/config": "deny",
      "*/.git/config": "deny",
      ".git/hooks/*": "deny",
      "*/.git/hooks/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/artifacts": "allow",
      "~/.pi/agent/artifacts/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "/var/folders": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders": "allow",
      "/private/var/folders/*": "allow"
    },
    "external_directory_read": {
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow",
      "~/.config/herdr-app/AGENTS.md": "allow",
      "~/.zshrc": "allow",
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      "~/.pi/agent/extensions/pi-permission-system/logs": "ask",
      "~/.pi/agent/extensions/pi-permission-system/logs/*": "ask",
      "/opt/homebrew/*": "allow",
      "/home/linuxbrew/.linuxbrew/*": "allow"
    },
    "bash": {
      "*": "allow",
      "git config *": "deny",
      "git -C * config *": "deny",
      "git push *": "ask",
      "git -C * push *": "ask",
      "git credential*": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "rm -r *": "ask",
      "rm -R *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm -Rf *": "ask",
      "rm -fR *": "ask",
      "sudo *": "ask",
      "sh": "ask",
      "bash": "ask",
      "zsh": "ask",
      "sh -s *": "ask",
      "bash -s *": "ask",
      "zsh -s *": "ask",
      "gh *": "ask",
      "gh --version": "allow",
      "gh auth status": "allow",
      "gh search *": "allow",
      "gh repo view *": "allow",
      "gh repo list *": "allow",
      "gh repo clone *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr diff *": "allow",
      "gh pr checks *": "allow",
      "gh pr status *": "allow",
      "gh pr checkout *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh run watch *": "allow",
      "gh release view *": "allow",
      "gh release list *": "allow",
      "gh api *": "allow",
      "gh api *-X*": "ask",
      "gh api *--method*": "ask",
      "gh api *-f*": "ask",
      "gh api *-F*": "ask",
      "gh api *--input*": "ask",
      "gh auth token*": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "chezmoi *": "ask",
      "chezmoi --version": "allow",
      "chezmoi diff *": "allow",
      "chezmoi status *": "allow",
      "chezmoi managed *": "allow",
      "chezmoi source-path *": "allow",
      "chezmoi target-path *": "allow",
      "chezmoi verify *": "allow",
      "chezmoi doctor *": "allow",
      "chezmoi cat *": {
        "action": "deny",
        "reason": "Never render secret templates."
      },
      "chezmoi execute-template *": {
        "action": "deny",
        "reason": "Never render secret templates."
      },
      "pi *": "ask",
      "pi --version": "allow",
      "pi list": "allow",
      "pi auth *": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "aws *": "ask",
      "az *": "ask",
      "scw *": "ask",
      "hcloud *": "ask",
      "kubectl *": "ask",
      "helm *": "ask",
      "terraform *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask",
      "rsync *:*": "ask",
      "aws secretsmanager get-secret-value *": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "security *": "ask",
      "security find-*-password *": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "security dump-keychain *": {
        "action": "deny",
        "reason": "Never print credentials."
      },
      "rex run *": "ask",
      "rex send *": "ask",
      "rex send-key *": "ask",
      "rex do *": "ask",
      "rex api call *": "ask",
      "herdr-app do *": "ask",
      "osascript *": "ask"
    }
  }
}
