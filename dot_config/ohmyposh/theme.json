{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bg": "#1a1b26",
    "bg_dark": "#16161e",
    "black": "#15161e",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "fg": "#c0caf5",
    "fg_dark": "#a9b1d6",
    "fg_gutter": "#3b4261",
    "green": "#9ece6a",
    "magenta": "#bb9af7",
    "orange": "#ff9e64",
    "purple": "#9d7cd8",
    "red": "#f7768e",
    "teal": "#1abc9c",
    "terminal_black": "#414868",
    "yellow": "#e0af68"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:black",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} ",
          "type": "os"
        },
        {
          "background": "p:fg_gutter",
          "foreground": "p:blue",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "template": " {{ .Path }} ",
          "type": "path",
          "options": {
            "style": "folder"
          }
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
