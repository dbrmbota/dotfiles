# =============================================================================
# Ghostty Configuration
# Theme: Tokyo Night Storm | Shell: zsh | Multiplexer: tmux
# Location: ~/.config/ghostty/config
# =============================================================================

# --- Appearance ---
theme = TokyoNight
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-thicken = true
adjust-cell-height = 0%

# --- Window ---
window-save-state = always
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend

# --- Behavior ---
copy-on-select = true
mouse-hide-while-typing = true
# Treat Option key as Alt — needed for tmux/neovim alt-based keybinds
macos-option-as-alt = true

# --- Ghostty keybinds → tmux prefix sequences ---
# These let you use Cmd+key in Ghostty to drive tmux, so it feels native macOS.
# Prefix is Ctrl-a (\x01). The second byte is the tmux key.

# Switch to tmux window N with Cmd+N
keybind = super+digit_1=text:\x01\x31
keybind = super+digit_2=text:\x01\x32
keybind = super+digit_3=text:\x01\x33
keybind = super+digit_4=text:\x01\x34
keybind = super+digit_5=text:\x01\x35
keybind = super+digit_6=text:\x01\x36
keybind = super+digit_7=text:\x01\x37
keybind = super+digit_8=text:\x01\x38
keybind = super+digit_9=text:\x01\x39

# New tmux window:     Cmd+t  → prefix + c
keybind = super+t=text:\x01\x63

# Close tmux pane:     Cmd+w  → prefix + x
keybind = super+w=text:\x01\x78

# Window picker (fzf): Cmd+p  → prefix + w
keybind = super+p=text:\x01\x77

# Rename tmux window:  Cmd+r  → prefix + ,
keybind = super+r=text:\x01\x2c

# Previous window:     Cmd+[  → prefix + p
keybind = super+left_bracket=text:\x01\x70

# Next window:         Cmd+]  → prefix + n
keybind = super+right_bracket=text:\x01\x6e

# Horizontal split:    Cmd+-  → prefix + "
keybind = super+minus=text:\x01\x22

# Vertical split:      Cmd+\  → prefix + %
keybind = super+backslash=text:\x01\x25

# Toggle pane zoom:    Cmd+z  → prefix + z
keybind = super+z=text:\x01\x7a

# tmux copy mode:      Cmd+f  → prefix + [
keybind = super+f=text:\x01\x5b

# Session picker:      Cmd+s  → prefix + s
keybind = super+s=text:\x01\x73

# New named session:   Cmd+Shift+n → prefix + N
keybind = super+shift+n=text:\x01\x4e

# Disable unused keybindings
keybind = super+d=unbind
keybind = super+shift+d=unbind

# Shell integration
# grapheme-width-method = legacy
shell-integration-features = title,ssh-env,ssh-terminfo
