{
  "$schema": "https://komorebi-for-mac.lgug2z.com/komorebi.0.1.0.schema.json",
  "app_specific_configuration_path": "$HOME/.config/komorebi/applications.json",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 8,
  "border": true,
  "border_width": 2,
  "border_offset": -5,
  "border_radius": 16,
  "floating_window_aspect_ratio": "Widescreen",
  "floating_layer_behaviour": "Float",
  "global_work_area_offset": {
    "left": 0,
    "top": 0,
    "right": 0,
    "bottom": 0
  },
  "resize_delta": 100,
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "^Control Cent(er|re)$",
      "matching_strategy": "Regex"
    }
  ],
  "floating_applications": [],
  "manage_rules": [],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
        {
          "name": "6",
          "layout": "BSP"
        },
        {
          "name": "7",
          "layout": "BSP"
        },
        {
          "name": "8",
          "layout": "BSP"
        }
      ]
    }
  ]
}
