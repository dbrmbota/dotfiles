# Focus / move
cmd - h : komorebic focus left
cmd - j : komorebic focus down
cmd - k : komorebic focus up
cmd - l : komorebic focus right
cmd + shift - h : komorebic move left
cmd + shift - j : komorebic move down
cmd + shift - k : komorebic move up
cmd + shift - l : komorebic move right
cmd + shift - 0x21 : komorebic cycle-focus previous # [
cmd + shift - 0x1E : komorebic cycle-focus next # ]
cmd - return : komorebic promote

# Stack
cmd - left : komorebic stack left
cmd - down : komorebic stack down
cmd - up : komorebic stack up
cmd - right : komorebic stack right
cmd - 0x29 : komorebic unstack # ;
cmd - 0x21 : komorebic cycle-stack previous # [
cmd - 0x1E : komorebic cycle-stack next # ]
cmd + shift - 0x29 : komorebic toggle-workspace-layer # ;

# Resize
cmd - 0x1B : komorebic resize-axis horizontal decrease # -
cmd - 0x18 : komorebic resize-axis horizontal increase # =
cmd + shift - 0x1B : komorebic resize-axis vertical decrease # -
cmd + shift - 0x18 : komorebic resize-axis vertical increase # =

# Window / layout
cmd - t : komorebic toggle-float
cmd + shift - t : komorebic toggle-workspace-float-override
cmd - f : komorebic toggle-monocle
cmd - r : komorebic retile
cmd - p : komorebic toggle-pause
cmd - 0 : komorebic toggle-window-container-behaviour
cmd - x : komorebic flip-layout horizontal
cmd - y : komorebic flip-layout vertical
cmd - n : komorebic cycle-layout next
cmd + shift - n : komorebic cycle-layout previous
cmd + shift - x : komorebic session-float-rule

# Workspaces
cmd - 1 : komorebic focus-workspace 0
cmd - 2 : komorebic focus-workspace 1
cmd - 3 : komorebic focus-workspace 2
cmd - 4 : komorebic focus-workspace 3
cmd - 5 : komorebic focus-workspace 4
cmd - 6 : komorebic focus-workspace 5
cmd - 7 : komorebic focus-workspace 6
cmd - 8 : komorebic focus-workspace 7
cmd + shift - 1 : komorebic move-to-workspace 0
cmd + shift - 2 : komorebic move-to-workspace 1
cmd + shift - 3 : komorebic move-to-workspace 2
cmd + shift - 4 : komorebic move-to-workspace 3
cmd + shift - 5 : komorebic move-to-workspace 4
cmd + shift - 6 : komorebic move-to-workspace 5
cmd + shift - 7 : komorebic move-to-workspace 6
cmd + shift - 8 : komorebic move-to-workspace 7
